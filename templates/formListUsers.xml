<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:xf="http://www.w3.org/2002/xforms" lang="fr">
  
  <head>
    <link type="text/css" href="static/xsltforms/xsltforms.css" rel="stylesheet"/>
    <script src="static/xsltforms/xsltforms.js"></script>
  </head>
  <body>
    <h1>Exemple de XForms avec pseudo-élément</h1>
    <xforms-model>
      <xforms-instance>
        <script type = "application/xml">{users}</script>
      </xforms-instance>
    </xforms-model>
    <form>
        <!-- @xf-nodeset doesn't work with pseudo-xforms-element -->
        <xforms-repeat xf-ref="user">
            <xforms-output xf-ref="@name"/>
        </xforms-repeat>
    </form>
  </body>
</html>