<section>
    <xforms-model>
        <xforms-instance id="user">
            <script type="application/xml">{user}</script>
        </xforms-instance>

        <xforms-instance id="permissions">
            <script type="application/xml">
                <permissions xmlns="">
                    <permission label="Aucune" value="none" />
                    <permission label="Lecture" value="read" />
                    <permission label="Écriture" value="write" />
                    <permission label="Création" value="create" />
                    <permission label="Admin" value="admin" />
                </permissions>
            </script>
        </xforms-instance>

        <xforms-instance id="pattern">
            <script type="application/xml">
                <database pattern="" permission="" xmlns="" />
            </script>
        </xforms-instance>

        <xforms-instance id="listDatabase">
            <script type="application/xml">{databases}</script>
        </xforms-instance>

        <xforms-instance id="mode">
            <script type="application/xml">{mode}</script>
        </xforms-instance>

        <xforms-instance id="confirmToken">
            <script type="application/xml">{token}</script>
        </xforms-instance>

        <xforms-instance id="grant">
            <script type="application/xml">
                <grant xmlns="" />
            </script>
        </xforms-instance>

        <xforms-instance id="uiState">
            <script type="application/xml">
                <ui xmlns="">
                    <createButton />
                    <confirmButton />
                </ui>
            </script>
        </xforms-instance>

        <xforms-bind xf-ref="instance('user')/@name" xf-required="true()" xf-relevant="instance('mode') != 'confirm'"/>
        <!-- <xforms-bind xf-ref="instance('user')/password" xf-required="true()" /> -->
        <xforms-bind xf-ref="instance('user')/@permission" xf-required="true()" xf-relevant="instance('mode') != 'confirm'"/>
        <xforms-bind xf-ref="instance('user')/info"  xf-relevant="instance('mode') != 'confirm'"/>
        <xforms-bind xf-ref="instance('uiState')/createButton" xf-relevant="instance('mode') != 'confirm'"/>
        <xforms-bind xf-ref="instance('uiState')/confirmButton" xf-relevant="instance('mode') = 'confirm'"/>

        <!-- /synopsx/users/{$username}/put -->

        <xforms-submission id="submitUserCreation" xf-mode="synchronous"
            xf-resource="/synopsx/users/create" xf-method="put" xf-replace="none">
            <xforms-action ev-event="xforms-submit-done">
                <xforms-message xf-level="modal"> La ressource a été enregistrée ! 
                    Status : <xforms-output xf-value="event('response-status-code')" />;
                    URI : <xforms-output xf-value="event('resource-uri')" />; 
                    Headers : <xforms-output xf-value="event('response-headers')" />;
                    Location : <xforms-output xf-value="event('response-headers')/self::*[name='content-location']/value" />;
                    Token : <xforms-output xf-value="event('response-headers')/self::*[name='content-token']/value" />;
                    Reason : <xforms-output xf-value="event('response-reason-phrase')" />;
                    Body : <xforms-output xf-value="event('response-body')" />.
                </xforms-message>
                <xforms-load xf-show="replace" xf-replace="instance">
                    <xforms-resource
                        xf-value="event('response-headers')/self::*[name='content-location']/value" />
                </xforms-load>
            </xforms-action>
            <xforms-action ev-event="xforms-submit-error">
                <xforms-message xf-level="modal">
                    Une erreur est apparue : <xforms-output xf-value="event('error-type')" />;
                    Status : <xforms-output xf-value="event('response-status-code')" />;
                    URI : <xforms-output xf-value="event('resource-uri')" />;
                    Headers : <xforms-output xf-value="event('response-headers')" />;
                    Reason : <xforms-output xf-value="event('response-reason-phrase')" />
                    Body : <xforms-output xf-value="event('response-body')" />.
                </xforms-message>
            </xforms-action>
        </xforms-submission>

        <xforms-submission id="submitUserConfirm" xf-mode="synchronous"
            xf-method="put" xf-replace="none">
            <xforms-resource
                xf-value="concat('/synopsx/users/', instance('user')/@name, '/confirm?token=', instance('confirmToken'))" />
            <xforms-action ev-event="xforms-submit-done">
                <xforms-message xf-level="modal"> La ressource a été enregistrée !
                    Status : <xforms-output xf-value="event('response-status-code')" />;
                    URI : <xforms-output xf-value="event('resource-uri')" />;
                    Headers : <xforms-output xf-value="event('response-headers')" />;
                    Reason : <xforms-output xf-value="event('response-reason-phrase')" />;
                    Body : <xforms-output xf-value="event('response-body')" />.
                </xforms-message>
                <xforms-load xf-show="replace" xf-resource="/synopsx/login" />
            </xforms-action>
            <xforms-action ev-event="xforms-submit-error">
                <xforms-message xf-level="modal">
                    Une erreur est apparue : <xforms-output xf-value="event('error-type')" />;
                    Status : <xforms-output xf-value="event('response-status-code')" />;
                    URI : <xforms-output xf-value="event('resource-uri')" />;
                    Headers : <xforms-output xf-value="event('response-headers')" />;
                    Reason : <xforms-output xf-value="event('response-reason-phrase')" />
                    Body : <xforms-output xf-value="event('response-body')" />.
                </xforms-message>
            </xforms-action>
        </xforms-submission>
    </xforms-model>
    <xforms-group xf-ref="instance('user')">
        <xforms-label>Nouveau compte utilisateur</xforms-label>
        <xforms-input xf-ref="@name">
            <xforms-label>Nom</xforms-label>
        </xforms-input>
        <br />
        <xforms-secret xf-ref="password">
            <xforms-label>Mot de passe</xforms-label>
        </xforms-secret>
        <br />
        <xforms-select1 xf-ref="@permission">
            <xforms-label>Permission (globale)</xforms-label>
            <xforms-itemset xf-ref="instance('permissions')/permission">
                <xforms-label xf-ref="@label" />
                <xforms-value xf-ref="@value" />
            </xforms-itemset>
        </xforms-select1>
        <br />
        <xforms-repeat xf-ref="database">
            <xforms-label>Pattern</xforms-label>
            <xforms-select1 xf-ref="@pattern">
                <xforms-label>Base de donnée</xforms-label>
                <xforms-itemset xf-ref="instance('listDatabase')/database">
                    <xforms-label xf-ref="." />
                    <xforms-value xf-ref="." />
                </xforms-itemset>
            </xforms-select1>
            <xforms-select1 xf-ref="@permission">
                <xforms-label>Permission</xforms-label>
                <xforms-itemset
                    xf-ref="instance('permissions')/permission[@value != 'admin' and @value != 'create']">
                    <xforms-label xf-ref="@label" />
                    <xforms-value xf-ref="@value" />
                </xforms-itemset>
            </xforms-select1>
        </xforms-repeat>
        <xforms-trigger xf-ref="instance('mode')/self::*[normalize-space(.) != 'confirm']">
            <xforms-label>Ajouter un pattern</xforms-label>
            <xforms-action ev-event="DOMActivate">
                <xforms-insert xf-origin="instance('pattern')" xf-nodeset="info" xf-position="before" />
            </xforms-action>
        </xforms-trigger>
        <xforms-group xf-ref="info">
            <xforms-repeat xf-ref="grant">
                <xforms-label>grant</xforms-label>
                <xforms-input xf-ref="." />
            </xforms-repeat>
            <xforms-trigger>
                <xforms-label>Ajouter une info</xforms-label>
                <xforms-action ev-event="DOMActivate">
                    <xforms-insert xf-origin="instance('grant')" xf-at="last()" xf-position="after" />
                </xforms-action>
            </xforms-trigger>
        </xforms-group>
        <xforms-output xf-value="serialize(.)" />
    </xforms-group>

    <xforms-trigger xf-ref="instance('uiState')/createButton">
        <xforms-label>Créer</xforms-label>
        <xforms-action ev-event="DOMActivate">
            <xforms-send xf-submission="submitUserCreation" />
        </xforms-action>
    </xforms-trigger>
    <xforms-trigger xf-ref="instance('uiState')/confirmButton">
        <xforms-label>Confirmer</xforms-label>
        <xforms-action ev-event="DOMActivate">
            <xforms-send xf-submission="submitUserConfirm" />
        </xforms-action>
    </xforms-trigger>
</section>